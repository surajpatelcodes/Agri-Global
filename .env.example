# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# .env.local is gitignored and will not be committed

# Application Domain Configuration
# Set this to the canonical production domain for email confirmations and password reset links.
VITE_APP_URL=https://aiada.co.in

# Supabase Configuration
VITE_SUPABASE_URL=https://xkazdyvmexcofbrgzmua.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Instructions:
# 1. Copy this file: cp .env.example .env.local
# 2. Replace the placeholder values with your actual Supabase credentials
# 3. Set VITE_APP_URL to the live domain after your domain migration
# 4. Never commit .env.local to Git
